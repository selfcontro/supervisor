# Codex/Cohere API Key
CODEX_API_KEY=your_api_key_here

# Model used for new agent threads (must be accepted by your codex CLI version)
CODEX_MODEL=gpt-5.6-sol

# Server port
PORT=3101

# Jev chooses whether a team workflow needs subagents. The local server reads
# the ignored ../jev_config.txt by default; set this to false to disable it.
JEV_ENABLED=true
